\citation{shoeybi2021megatron}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stream-level analysis of the $L{=}32$ model. \textbf  {(a)} deleting any stream destroys the model, and the spread across streams is only $1.75\times $. \textbf  {(b)} normalising each stream by its own mean reveals a monotonic split along token frequency: streams 2 and 3 carry rare tokens, streams 0 and 1 carry common ones. \textbf  {(c)} decoded alone, no stream reproduces more than $3.5\%$ of the model's predictions. \textbf  {(d,e)} activation similarity and router entropy per layer, against the $-1/(N{-}1)$ floor and $\log N$. \textbf  {(f)} in weight space the per-stream attention and FFN matrices are uncorrelated at every depth, while the distribute matrices share a small component that decays with depth.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:subablate}{{5}{11}{Stream-level analysis of the $L{=}32$ model. \textbf {(a)} deleting any stream destroys the model, and the spread across streams is only $1.75\times $. \textbf {(b)} normalising each stream by its own mean reveals a monotonic split along token frequency: streams 2 and 3 carry rare tokens, streams 0 and 1 carry common ones. \textbf {(c)} decoded alone, no stream reproduces more than $3.5\%$ of the model's predictions. \textbf {(d,e)} activation similarity and router entropy per layer, against the $-1/(\nsub {-}1)$ floor and $\log \nsub $. \textbf {(f)} in weight space the per-stream attention and FFN matrices are uncorrelated at every depth, while the distribute matrices share a small component that decays with depth}{figure.5}{}}
