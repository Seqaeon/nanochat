\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Resource multiplier a dense model needs to match each MST model, obtained by inverting the dense power-law fit. The multiplier is stable across the range. Matrix parameters (embeddings, value embeddings and the output head excluded) is the primary parameter axis, following \citet  {kaplan2020scaling}; total parameters are reported below the rule for completeness. $^\dagger $FLOPs per token is an inference-cost axis and is only comparable across architectures at fixed training data; see Section~\ref {sec:isotoken}.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:ratio}{{2}{8}{Resource multiplier a dense model needs to match each MST model, obtained by inverting the dense power-law fit. The multiplier is stable across the range. Matrix parameters (embeddings, value embeddings and the output head excluded) is the primary parameter axis, following \citet {kaplan2020scaling}; total parameters are reported below the rule for completeness. $^\dagger $FLOPs per token is an inference-cost axis and is only comparable across architectures at fixed training data; see Section~\ref {sec:isotoken}}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Power-law fits $\textsc  {bpb}= a x^{b}$, MST $L\!\in \![16,24]$ (three points) and dense $L\!\in \![8,30]$ (eleven points). The MST $R^2$ values are materially lower than dense's; with three points these fits are descriptive, not predictive.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:fits}{{3}{8}{Power-law fits $\bpb = a x^{b}$, MST $L\!\in \![16,24]$ (three points) and dense $L\!\in \![8,30]$ (eleven points). The MST $R^2$ values are materially lower than dense's; with three points these fits are descriptive, not predictive}{table.3}{}}
