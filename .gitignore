.venv/
venv/
__pycache__/
*.pyc
dev-ignore/
report.md
eval_bundle/

# Secrets
.env

# Local setup
CLAUDE.md
wandb/

# Training artifacts and large outputs
out/
data
head_d4_v131k.pt
head_d8_v131k.pt
head_d12_v131k.pt
